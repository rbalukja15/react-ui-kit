  { "name": "/rhf, everything", "path": "dist/rhf.js", "import": "*", "limit": "2.5 kB" },
  { "name": "/date-picker, everything", "path": "dist/date-picker.js", "import": "*", "limit": "1.5 kB", "ignore": ["@mui/x-date-pickers"] },
  { "name": "/date-picker/rhf, everything", "path": "dist/date-picker/rhf.js", "import": "*", "limit": "1.5 kB", "ignore": ["@mui/x-date-pickers"] }
